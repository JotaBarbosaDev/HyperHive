{
  "expo": {
    "name": "HyperHive",
    "slug": "hyperhive",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/android-chrome-512x512.png",
    "scheme": "hyperhive",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-chrome-512x512.png",
        "backgroundColor": "#0E1524"
      },
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.anonymous.hyperhive",
      "versionCode": 1000001
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon-32x32.png",
      "manifest": {
        "name": "HyperHive",
        "short_name": "HyperHive",
        "icons": [
          {
            "src": "./assets/images/favicon-16x16.png",
            "sizes": "16x16",
            "type": "image/png"
          },
          {
            "src": "./assets/images/favicon-32x32.png",
            "sizes": "32x32",
            "type": "image/png"
          },
          {
            "src": "./assets/images/android-chrome-192x192.png",
            "sizes": "192x192",
            "type": "image/png"
          },
          {
            "src": "./assets/images/android-chrome-512x512.png",
            "sizes": "512x512",
            "type": "image/png"
          },
          {
            "src": "./assets/images/apple-touch-icon.png",
            "sizes": "180x180",
            "type": "image/png",
            "purpose": "any maskable"
          }
        ]
      }
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/android-chrome-512x512.png",
          "resizeMode": "contain",
          "backgroundColor": "#0E1524"
        }
      ],
      "expo-secure-store",
      [
        "expo-navigation-bar",
        {
          "hidden": false
        }
      ],
      "./plugins/withAndroidUserCertificates",
      "expo-sharing",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
